{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "-1"
    },
    "analysis": {
      "filter": {
        "autocomplete_edge": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 15
        },
        "autocomplete_min_length": {
          "type": "length",
          "min": 2
        },
        "autocomplete_truncate": {
          "type": "truncate",
          "length": 15
        }
      },
      "analyzer": {
        "folded": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        },
        "autocomplete": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "autocomplete_edge"]
        },
        "autocomplete_search": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "autocomplete_min_length", "autocomplete_truncate"]
        }
      },
      "normalizer": {
        "folded_keyword": {
          "type": "custom",
          "char_filter": [],
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "name": {
        "type": "text",
        "analyzer": "folded",
        "fields": {
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete",
            "search_analyzer": "autocomplete_search"
          },
          "norm": {"type": "keyword", "normalizer": "folded_keyword", "ignore_above": 1024}
        }
      },
      "brands": {
        "type": "keyword",
        "ignore_above": 256,
        "fields": {
          "text": {"type": "text", "analyzer": "folded"},
          "norm": {"type": "keyword", "normalizer": "folded_keyword", "ignore_above": 256}
        }
      },
      "categories": {
        "type": "keyword",
        "ignore_above": 256,
        "fields": {
          "text": {"type": "text", "analyzer": "folded"},
          "norm": {"type": "keyword", "normalizer": "folded_keyword", "ignore_above": 256}
        }
      },
      "nutriscore": {"type": "keyword"}
    }
  }
}
