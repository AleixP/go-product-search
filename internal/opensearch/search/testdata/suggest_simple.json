{
  "size": 10,
  "track_total_hits": false,
  "_source": [
    "name"
  ],
  "query": {
    "match": {
      "name.autocomplete": {
        "query": "choc",
        "operator": "and"
      }
    }
  },
  "collapse": {
    "field": "name.norm"
  },
  "sort": [
    {
      "_score": "desc"
    },
    {
      "name.norm": "asc"
    }
  ]
}
